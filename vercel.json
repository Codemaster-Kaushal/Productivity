{
  "version": 2,
  "buildCommand": "echo 'Pre-built package, skipping build'",
  "outputDirectory": "frontend/public",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
